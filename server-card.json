{
  "name": "unitymcptest",
  "title": "Unity MCP Test Loop",
  "description": "A paid remote MCP for Unity-MCP, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://unitymcptest.clauxel.com/",
  "documentationUrl": "https://unitymcptest.clauxel.com/mcp/",
  "endpointUrl": "https://unitymcptest.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://unitymcptest.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://unitymcptest.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://unitymcptest.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "studio",
    "pricing": [
      {
        "id": "indie",
        "name": "Indie",
        "monthlyUsd": 39
      },
      {
        "id": "studio",
        "name": "Studio",
        "monthlyUsd": 149
      },
      {
        "id": "production",
        "name": "Production",
        "monthlyUsd": 499
      }
    ]
  },
